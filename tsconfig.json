{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    /* Type Safety Standards:
     * - strict: true (enforced) - enables all strict type checking options
     * - No 'any' types policy - verified via grep, no instances found
     *
     * Enhanced options evaluated but not enabled:
     * - noUncheckedIndexedAccess: Would require extensive refactoring of facial landmark
     *   array access (68 guaranteed points). Cost/benefit not justified for current codebase.
     * - exactOptionalPropertyTypes: Conflicts with existing optional property patterns.
     * - noPropertyAccessFromIndexSignature: Not needed given current architecture.
     *
     * Current configuration provides strong type safety while maintaining
     * practical development workflow. Revisit enhanced options in future refactoring.
     */

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
